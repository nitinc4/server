# ==============================================================
# ZUDO MONOREPO .gitignore
# Covers: Flutter apps (zudo_new, zudo_b2b, zudo_delivery)
#         Node.js server (server/)
#         OS & editor artifacts
# ==============================================================

Zudo seller panel/


# ---------------------------------------------------------------
# NODE.JS / SERVER
# ---------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment & secrets — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Server build output
server/dist/
server/build/
server/logs/
server/uploads/


# ---------------------------------------------------------------
# FLUTTER / DART
# ---------------------------------------------------------------
# Pub cache & generated files
**/.dart_tool/
**/.pub-cache/
**/.pub/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/pubspec.lock

# Build outputs
**/build/
**/coverage/
**/.buildlog/
**/doc/api/
migrate_working_dir/

# Symbolication / obfuscation maps
app.*.symbols
app.*.map.json

# Android build artefacts
**/android/.gradle/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/local.properties
**/android/key.properties
**/android/app/google-services.json
**/*.jks
**/*.keystore

# iOS build artefacts
**/ios/.last_build_id
**/ios/Flutter/App.framework/
**/ios/Flutter/Flutter.framework/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/Generated.xcconfig/
**/ios/Pods/
**/ios/Runner.xcworkspace/xcshareddata/
**/ios/Runner.xcworkspace/xcuserdata/
**/ios/.symlinks/
**/ios/Flutter/.last_build_id
**/GoogleService-Info.plist

# macOS build artefacts
**/macos/Flutter/GeneratedPluginRegistrant.swift

# Windows build artefacts
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake

# Linux build artefacts
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake

# Web
**/web/flutter_service_worker.js
**/web/flutter.js


# ---------------------------------------------------------------
# OS ARTIFACTS
# ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Temp files
*.tmp
*.temp
~$*
~WRL*.tmp


# ---------------------------------------------------------------
# IDE / EDITOR
# ---------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# JetBrains
.idea/
out/
*.class

# Vim
*.swp
*.swo
*.pyc


# ---------------------------------------------------------------
# LOGS & MISC
# ---------------------------------------------------------------
*.log
*.pyc
*.pyo
*.svn/
.swiftpm/
.atom/
.history/


# ---------------------------------------------------------------
# DOCUMENT DRAFTS (optional - remove if you want to track these)
# ---------------------------------------------------------------
*.docx
*.pdf
*.txt
